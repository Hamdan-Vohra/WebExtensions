{
  "manifest_version": 3,
  "name": "YouTube Auto Pause/Play",
  "version": "1.0",
  "description": "Automatically pauses and plays YouTube videos when switching tabs or windows.",
  "permissions": ["scripting", "tabs", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"]
    }
  ],
  "host_permissions": ["*://www.youtube.com/*"]
}
